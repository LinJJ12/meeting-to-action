{
  "name": "@meeting-to-action/core",
  "version": "0.1.2",
  "description": "Turn meeting transcripts into traceable decisions, action items, and minutes with evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinJJ12/meeting-to-action.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "skill:schema": "tsx scripts/export-skill-schema.ts",
    "mcp": "node dist/mcp/server.js",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "setup:client": "node dist/setup.js",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:check-installed": "node scripts/check-installed-plugin.mjs",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "lint": "eslint .",
    "preflight": "npm run typecheck && npm run lint && npm run build && npm test && npm run mcp:smoke && npm run plugin:build && npm run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.0.8"
  }
}
