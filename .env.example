# Model provider configuration. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
# Optional: include a best-effort redacted, truncated provider error excerpt in messages.
# Only common secret patterns are replaced with [REDACTED]; the excerpt may still contain
# sensitive content (provider error bodies can echo the request and the transcript).
# Leave unset normally and enable only for local troubleshooting.
OPENAI_VERBOSE_ERRORS=