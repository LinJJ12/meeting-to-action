# Model provider configuration. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
# Optional: include a redacted provider response excerpt in error messages.
# Leave unset normally — provider error bodies can echo the request (and the transcript).
OPENAI_VERBOSE_ERRORS=