# Model provider configuration. Never commit real secrets.
# The CLI only reads this file when you pass --env <path> explicitly; it never
# loads a .env from the working directory on its own.
OPENAI_API_KEY=
OPENAI_MODEL=
# Must be https, except plain http is allowed for localhost/127.0.0.1/[::1].
# Everything you analyze is sent to this endpoint — only point it at servers you trust.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
# Optional: set 1 to allow plain http endpoints other than loopback (plaintext on the wire).
OPENAI_ALLOW_INSECURE=
# Optional: include a best-effort redacted, truncated provider error excerpt in messages.
# Only common secret patterns are replaced with [REDACTED]; the excerpt may still contain
# sensitive content (provider error bodies can echo the request and the transcript).
# Leave unset normally and enable only for local troubleshooting.
OPENAI_VERBOSE_ERRORS=
